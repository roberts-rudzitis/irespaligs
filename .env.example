# Copy to .env and fill in. NEVER commit .env.
# Local development works without a .env file (docker-compose.yml has dev defaults).

# --- Django ---
# Production: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 = local development, 0 = production
DJANGO_DEBUG=1
# Comma-separated, e.g. irespaligs.lv,www.irespaligs.lv
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins, e.g. https://irespaligs.lv
DJANGO_CSRF_TRUSTED_ORIGINS=

# Admin panel path, e.g. "office-7f3k/" (keep the trailing slash)
DJANGO_ADMIN_URL=admin/

# --- Database ---
DATABASE_URL=postgres://irespaligs:irespaligs@db:5432/irespaligs

# --- Stripe (test keys start with sk_test_ / whsec_; see README "Payments") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (price_...), created with tax behaviour "inclusive"
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Email (Brevo SMTP in production; empty = print emails to the console) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ĪresPalīgs <noreply@example.lv>
